# Copy to .env and adjust. .env is git-ignored.

# Where the Nutriblend API server is running (no trailing slash, no /api/v1).
SERVER_URL=http://localhost:8000
API_PREFIX=/api/v1

# Seconds to wait for ordinary API calls.
REQUEST_TIMEOUT_SECONDS=15

# Timezone used to display dates.
DISPLAY_TIMEZONE=Asia/Kolkata

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
