# Copy to .env and adjust. .env is git-ignored.

# Where the Nutriblend API server is running (no trailing slash, no /api/v1).
SERVER_URL=http://localhost:8000
# API address as the admin's BROWSER reaches it (upload box). Empty = SERVER_URL.
PUBLIC_SERVER_URL=
API_PREFIX=/api/v1

# Seconds to wait for ordinary API calls.
REQUEST_TIMEOUT_SECONDS=15

# Timezone used to display dates.
DISPLAY_TIMEZONE=Asia/Kolkata

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Stay signed in across a browser refresh (the tab's key is erased when the tab is closed; tokens stay in the
# dashboard process, and a restart signs everyone out). Hours without use before the key stops working. 0 = off.
SESSION_REMEMBER_HOURS=12
