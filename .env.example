# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME=Nutriblend API
# development | production
#   development -> the OTP is echoed back in the request-otp response (dev_otp)
#   production  -> it never is. Set this to production before going live.
ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local dev default:
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas (replace <user>, <password>, <cluster>; URL-encode special
# characters in the password, e.g. @ becomes %40):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
MONGO_DB_NAME=nutriblend
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# ── Tokens ────────────────────────────────────────────────────────────────────
# Generate a real secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
# Short-lived bearer token sent on every request.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived rotating token used to get new access tokens.
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ── API surface ───────────────────────────────────────────────────────────────
# All endpoints live under this prefix. /api/health stays unversioned.
API_PREFIX=/api/v1

# ── Accounts ──────────────────────────────────────────────────────────────────
# Abandoned signups (created but never OTP-verified) are auto-deleted after this
# long, so no mobile number is locked up by someone who never finished.
PENDING_USER_TTL_HOURS=24
# One account per email address, when an email is supplied.
ENFORCE_UNIQUE_EMAIL=true

# ── Admin dashboard ───────────────────────────────────────────────────────────
# POST /api/v1/admin/admins (create admin) is OPEN while this is true.
# Set to false before the server is reachable from the internet.
ADMIN_CREATE_ENABLED=true
# Optional extra lock: comma-separated numbers. When set, an admin also needs a
# listed number. Empty = the role alone decides.
ADMIN_MOBILE_NUMBERS=
# What "today" means in the dashboard's statistics.
ADMIN_TIMEZONE=Asia/Kolkata

# ── Media (videos & thumbnails) ───────────────────────────────────────────────
# Where files are stored. "local" = MEDIA_ROOT folder on this server (development).
# Move to cloud storage (Cloudflare R2 / S3) before go-live.
STORAGE_PROVIDER=local
MEDIA_ROOT=media
MAX_VIDEO_SIZE_MB=4096
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=24
MAX_THUMBNAIL_SIZE_MB=5
# Documents attached to videos (PDF/Word/PowerPoint, view-only). 0 = no size limit.
MAX_DOCUMENT_SIZE_MB=0
DOCUMENT_PAGE_WIDTH=1400
# LibreOffice converts Word/PowerPoint for viewing. Empty = auto-detect.
LIBREOFFICE_PATH=
DOCUMENT_CONVERT_TIMEOUT_SECONDS=300
# Playback/thumbnail links expire after this many seconds.
MEDIA_URL_TTL_SECONDS=3600
# Secret for signing media links. Empty = derived from JWT_SECRET.
MEDIA_URL_SECRET=
# Public base URL for media links (e.g. https://api.nutriblend.in). Empty = from the request.
PUBLIC_BASE_URL=

# ── Rate limiting (OTP abuse protection) ──────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Minimum gap between OTPs for one number. Drives the app's "Resend in 47s".
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_MOBILE_PER_HOUR=5
OTP_MAX_PER_MOBILE_PER_DAY=10
OTP_MAX_PER_IP_PER_HOUR=20
VERIFY_MAX_PER_IP_PER_HOUR=100
# Read the client IP from X-Forwarded-For. Turn this ON only when the app is
# behind a proxy YOU control. If it is on without a proxy, callers can forge the
# header and walk straight around every per-IP limit. If it is off behind a
# proxy, every user looks like one IP and they throttle each other.
TRUST_PROXY_HEADERS=false

# ── SMS delivery ──────────────────────────────────────────────────────────────
# mock | msg91 | twilio | fast2sms
# "mock" sends nothing and just logs the OTP — fine for development.
SMS_PROVIDER=mock
SMS_COUNTRY_CODE=91
SMS_TEMPLATE={otp} is your Nutriblend verification code. It is valid for {minutes} minutes.
SMS_TIMEOUT_SECONDS=10

# MSG91 (needs a DLT-approved template containing ##OTP##)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Twilio (FROM must be E.164, e.g. +15551234567)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Fast2SMS (route "otp" needs no DLT template; route "dlt" needs the two extras)
# FAST2SMS_API_KEY=
# FAST2SMS_ROUTE=otp
# FAST2SMS_SENDER_ID=
# FAST2SMS_MESSAGE_ID=

# ── Legal pages (/privacy-policy, /account-deletion) ─────────────────────────
# Fill these before publishing the app. Empty values show as "[to be filled]"
# on the public pages and are flagged in the dashboard's Privacy policy page.
LEGAL_APP_NAME=Nutriblend
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_GRIEVANCE_OFFICER=
LEGAL_GRIEVANCE_EMAIL=
LEGAL_HOSTING_PROVIDER=
PRIVACY_POLICY_EFFECTIVE_DATE=
LEGAL_DELETION_DAYS=30
LEGAL_LOG_RETENTION_DAYS=90
